root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[{justfile,Justfile}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# No [*.{js,mjs}] block on purpose. Most JavaScript here is vendored —
# native/vncviewer/assets/ is noVNC plus pako — and the first-party files do
# not agree either: app/public/app.js indents 2, e2e/ and worker/ indent 4.
# A single declaration would either fight the vendored trees or rewrite our
# own on save.
