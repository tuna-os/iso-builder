<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TunaOS.MediaWriter.App.Pages.DonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Success -->
        <StackPanel x:Name="SuccessPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="520">
            <FontIcon Glyph="&#xE930;" FontSize="56" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            <TextBlock x:Name="DoneTitleText" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="DoneText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
            <HyperlinkButton x:Name="DocsLink" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Failure -->
        <Grid x:Name="FailurePanel" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="True" IsClosable="False" />
            <Grid x:Name="DetailsPanel" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="DetailsBox"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button x:Name="CopyButton" Grid.Row="1" Click="OnCopyDetails" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DetailsButton" Click="OnToggleDetails" />
            <Button x:Name="ShowInFolderButton" Click="OnShowInFolder" />
            <Button x:Name="SecondaryButton" Grid.Column="2" Click="OnSecondary" />
            <Button x:Name="PrimaryButton" Grid.Column="3" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="OnPrimary" />
        </Grid>
    </Grid>
</Page>
