<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TunaOS.MediaWriter.App.Pages.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            x:Name="WhatText"
            Grid.Row="1"
            TextWrapping="Wrap"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="10" MaxWidth="560">
            <Grid>
                <TextBlock x:Name="PhaseText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="PercentText"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="6" />
            <TextBlock
                x:Name="HintText"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Button x:Name="CancelButton" Grid.Row="3" HorizontalAlignment="Right" MinWidth="120" Click="OnCancel" />
    </Grid>
</Page>
