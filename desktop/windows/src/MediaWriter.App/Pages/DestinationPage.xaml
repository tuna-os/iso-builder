<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TunaOS.MediaWriter.App.Pages.DestinationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TunaOS.MediaWriter.App.Pages">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            x:Name="SubtitleText"
            Grid.Row="1"
            TextWrapping="Wrap"
            Style="{StaticResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ListView
            x:Name="DriveList"
            Grid.Row="2"
            Margin="0,8,0,0"
            SelectionMode="Single"
            SelectionChanged="OnDriveSelectionChanged"
            AutomationProperties.Name="USB sticks">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DriveItem">
                    <Grid Padding="4,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE88E;" FontSize="28" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Detail}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyPanel"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE88E;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBack" />
            <Button x:Name="SaveButton" Grid.Column="2" Click="OnSaveIso" />
            <Button
                x:Name="WriteButton"
                Grid.Column="3"
                MinWidth="160"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="False"
                Click="OnWrite" />
        </Grid>
    </Grid>
</Page>
