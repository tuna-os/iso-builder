[Desktop Entry]
Type=Application
Name=TunaOS Media Writer
GenericName=USB Stick Writer
Comment=Make a bootable TunaOS USB stick
Exec=tunaos-media-writer %u
Icon=org.tunaos.MediaWriter
Terminal=false
Categories=Utility;GTK;
Keywords=usb;iso;installer;boot;live;tunaos;
StartupNotify=true
MimeType=x-scheme-handler/tunaos-media-writer;
